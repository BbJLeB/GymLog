<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#12121A"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <TextView android:id="@+id/tvExName"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F0F0F5"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Button android:id="@+id/btnDeleteEx"
            android:layout_width="32dp" android:layout_height="32dp"
            android:text="✕"
            android:textSize="12sp"
            android:backgroundTint="#1A1A26"
            android:textColor="#6B6B85"
            android:padding="0dp"/>
    </LinearLayout>

    <!-- Chips row -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/llChips"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <TextView android:id="@+id/tvSetCount"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#6B6B85"
            android:textSize="12sp"/>

        <Button android:id="@+id/btnRemoveSet"
            android:layout_width="wrap_content" android:layout_height="38dp"
            android:text="- отмени"
            android:textSize="11sp"
            android:backgroundTint="#1A1A26"
            android:textColor="#6B6B85"
            android:layout_marginEnd="8dp"/>

        <Button android:id="@+id/btnAddSet"
            android:layout_width="100dp" android:layout_height="44dp"
            android:text="+ СЕРИЯ"
            android:textColor="#000000"
            android:backgroundTint="#E8FF47"
            android:textStyle="bold"
            android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>
