<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#12121A"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <TextView android:id="@+id/tvStatName"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#F0F0F5"
        android:textSize="15sp"
        android:textStyle="bold"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center">
        <TextView android:id="@+id/tvStatTotal"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#E8FF47"
            android:textSize="28sp"
            android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="общо серии" android:textColor="#6B6B85" android:textSize="10sp"/>
    </LinearLayout>
</LinearLayout>
